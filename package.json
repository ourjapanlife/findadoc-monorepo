{
    "name": "findadoc",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.27.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@findadoc/web",
        "dev:server": "turbo run dev --filter=@findadoc/server",
        "dev:mcp": "turbo run dev --filter=@findadoc/mcp",
        "dev:mcp:http": "turbo run dev:http --filter=@findadoc/mcp",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "lint:locales": "turbo run lint:locales --filter=@findadoc/web",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test --filter=@findadoc/web --filter=@findadoc/mcp",
        "test:server": "turbo run test --filter=@findadoc/server",
        "test:e2e": "turbo run test:e2e:headless --filter=@findadoc/web",
        "generate": "turbo run generate",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "turbo": "^2.6.1"
    },
    "pnpm": {
        "overrides": {
            "@simple-git/argv-parser": "2.0.1",
            "long": "^4.0.0"
        },
        "onlyBuiltDependencies": [
            "@apollo/protobufjs",
            "@swc/core",
            "browser-tabs-lock",
            "esbuild",
            "protobufjs",
            "supabase",
            "unrs-resolver",
            "vue-demi"
        ]
    }
}
