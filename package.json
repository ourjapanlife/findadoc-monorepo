{
    "name": "findadoc",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.27.0",
    "engines": {
        "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "pnpm exec turbo dev",
        "dev:web": "pnpm exec turbo dev --filter=@findadoc/web --filter=@findadoc/server",
        "dev:server": "pnpm exec turbo dev --filter=@findadoc/server",
        "dev:seeded": "pnpm exec turbo dev:seeded --filter=@findadoc/web --filter=@findadoc/server",
        "dev:api": "pnpm exec turbo dev:api --filter=@findadoc/web",
        "check:supabase": "pnpm exec turbo check:supabase --filter=@findadoc/server",
        "db:seed": "pnpm exec turbo db:seed",
        "db:reset": "pnpm exec turbo db:reset",
        "dev:mcp": "pnpm exec turbo dev --filter=@findadoc/mcp",
        "dev:mcp:http": "pnpm exec turbo dev:http --filter=@findadoc/mcp",
        "build": "pnpm exec turbo build",
        "lint": "pnpm exec turbo lint",
        "lint:fix": "pnpm exec turbo lint:fix",
        "lint:locales": "pnpm exec turbo lint:locales --filter=@findadoc/web",
        "lint:docs": "pnpm --filter @findadoc/docs lint",
        "typecheck": "pnpm exec turbo typecheck",
        "test": "pnpm exec turbo test --filter=@findadoc/web --filter=@findadoc/mcp --filter=@findadoc/utils",
        "test:server": "pnpm exec turbo test --filter=@findadoc/server",
        "test:e2e": "pnpm exec turbo test:e2e:headless --filter=@findadoc/web",
        "generate": "pnpm exec turbo generate",
        "docs": "pnpm --filter @findadoc/docs docs:serve",
        "docs:build": "pnpm --filter @findadoc/docs docs:build",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "turbo": "^2.11.6"
    }
}
