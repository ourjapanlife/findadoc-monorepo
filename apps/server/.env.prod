TEST_ENABLED = false
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 4000
API_URL = "https://api.findadoc.jp"
WEBSITE_URL = "https://www.findadoc.jp"
AUTH_AUTH0_URL = "https://findadoc-japan-prod.auth0.com"
AUTH_GITHUB_CLIENT_ID = "ae74afe14f585c26202c"
# Logging
# Logs are JSON lines on stdout. LOG_LEVEL overrides the production default of info.
# LOG_LEVEL = debug

# Auth
# Prod auth uses this field to authenticate with Auth0. You can get a token here (https://auth0.com/organizations/org_7j)
# AUTH_AUTH0_API_KEY = 'enteryourkeyhere'
# This is from your github. You probably won't need to add this. 
# AUTH_GITHUB_CLIENT_SECRET = 'enteryourkeyhere'

# Places calls from this server. Do not commit the value; set it on the host.
# GOOGLE_API_KEY = 'enteryourkeyhere'

# Sentry
# SENTRY_DSN = 'enteryourdsnhere'
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

