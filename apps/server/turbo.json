{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "outputs": ["dist/**"]
        },
        "test": {
            "outputs": ["coverage/**"]
        },
        "db:seed": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputLogs": "full"
        },
        "db:reset": {
            "cache": false,
            "outputLogs": "full"
        }
    }
}
