{
    "name": "@findadoc/web",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "wait-on -t 60000 http-get://127.0.0.1:4000/health && cross-env NUXT_USE_LOCAL_API=true nuxi dev",
        "dev:seeded": "wait-on -t 300000 http-get://127.0.0.1:4000/health && cross-env NUXT_USE_LOCAL_API=true nuxi dev",
        "dev:api": "nuxi dev",
        "lint": "pnpm prepare:ci && eslint . -c eslint.config.js",
        "lint:fix": "pnpm prepare:ci && eslint . -c eslint.config.js --fix",
        "lint:locales": "node i18n/checkLocaleKeys.js",
        "lint:cleanlocales": "node i18n/cleanUnusedLocaleKeys.js",
        "typecheck": "node i18n/checkLocaleKeys.js && nuxi prepare && nuxi typecheck",
        "build": "nuxi generate",
        "prepare:ci": "nuxi prepare",
        "test": "pnpm test:unit",
        "test:unit": "nuxi prepare && vitest run -c vitest.unit.config.ts --coverage",
        "test:unit:coverage": "nuxi prepare && vitest run -c vitest.unit.config.ts --coverage",
        "test:e2e:headless": "playwright test",
        "dev:e2e": "node -e \"console.log('\\n>> Starting Nuxt dev server on port 4242 for e2e tests...\\n')\" && cross-env NUXT_IS_TESTING_MODE=true NUXT_USE_LOCAL_API=true NUXT_PUBLIC_LOAD_STORES=true nuxi dev --port 4242",
        "test:e2e:local": "cross-env E2E_WEB_SERVER_EXTERNAL=true start-server-and-test dev:e2e http://localhost:4242 test:e2e:headless",
        "test:e2e:local:ui": "cross-env E2E_WEB_SERVER_EXTERNAL=true start-server-and-test dev:e2e http://localhost:4242 \"playwright test --ui\"",
        "test:e2e:local:prod": "start-server-and-test \"cross-env NUXT_IS_TESTING_MODE=true pnpm build && cross-env NUXT_IS_TESTING_MODE=true PORT=4242 pnpm exec serve .output/public\" http://localhost:4242 \"PLAYWRIGHT_BASE_URL=http://localhost:4242 playwright test\"",
        "storybook": "cross-env NUXT_STORYBOOK=true nuxi dev -p 7331 && storybook dev -p 6006"
    },
    "engines": {
        "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
    },
    "type": "module",
    "dependencies": {
        "@auth0/auth0-vue": "^2.5.0",
        "@findadoc/graphql": "workspace:*",
        "@findadoc/utils": "workspace:*",
        "@fontsource/noto-sans": "5.3.0",
        "@fontsource/noto-sans-jp": "^5.3.0",
        "@fontsource/noto-sans-kr": "^5.3.0",
        "@fullcalendar/core": "6.1.19",
        "@fullcalendar/interaction": "6.1.19",
        "@fullcalendar/luxon3": "6.1.19",
        "@fullcalendar/timegrid": "6.1.19",
        "@fullcalendar/vue3": "6.1.19",
        "@pinia/nuxt": "^0.11.3",
        "@sentry/vue": "^10.58.0",
        "graphql": "catalog:",
        "graphql-request": "^7.4.0",
        "luxon": "3.7.2",
        "nuxt-svgo": "^4.2.6",
        "pinia": "^3.0.4",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.26",
        "vue-gtag": "^3.6.3",
        "vue-router": "^4.6.3",
        "vue-server-renderer": "^2.7.16",
        "vue-template-compiler": "^2.7.16",
        "vue3-google-map": "^0.27.0"
    },
    "devDependencies": {
        "@microsoft/eslint-formatter-sarif": "^3.1.0",
        "@nuxt/eslint": "^1.12.1",
        "@nuxt/test-utils": "^4.3.3",
        "@nuxt/types": "^2.18.1",
        "@nuxtjs/i18n": "^10.2.1",
        "@nuxtjs/sitemap": "^8.5.0",
        "@nuxtjs/storybook": "^10.0.1",
        "@pinia/testing": "^1.0.3",
        "@playwright/test": "^1.49.0",
        "@storybook/addon-a11y": "^10.6.2",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-links": "^10.6.2",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@swc/core": "^1.15.8",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/google.maps": "^3.58.1",
        "@types/luxon": "3.7.1",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/eslint-plugin": "^1.6.5",
        "@vue/test-utils": "^2.4.6",
        "all-contributors-cli": "^6.26.1",
        "autoprefixer": "^10.4.23",
        "cross-env": "^10.1.0",
        "dotenv": "^16.3.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-better-tailwindcss": "4.9.1",
        "eslint-plugin-json": "^4.0.1",
        "eslint-plugin-storybook": "^10.6.2",
        "eslint-plugin-vue": "^10.6.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "jsdom": "^27.4.0",
        "nuxt": "^4.6.1",
        "nuxt-gtag": "^4.1.0",
        "nuxt-viewport": "^2.3.1",
        "postcss": "^8.5.6",
        "postcss-html": "^1.8.0",
        "rolldown": "~1.2.11",
        "serve": "14.2.6",
        "start-server-and-test": "^2.0.3",
        "storybook": "^10.6.2",
        "tailwindcss": "^4.3.3",
        "typescript": "catalog:",
        "typescript-eslint": "^8.51.0",
        "vite": "^8.3.2",
        "vitest": "^4.0.16",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.3.11",
        "wait-on": "^8.0.1"
    }
}
