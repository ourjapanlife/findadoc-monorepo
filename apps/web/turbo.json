{
    "$schema": "https://turborepo.com/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "cache": false,
            "passThroughEnv": ["GOOGLE_MAPS_API_KEY", "NUXT_*"]
        },
        "test": {
            "outputs": ["coverage/**"]
        },
        "test:unit:coverage": {
            "outputs": ["coverage/**"]
        }
    }
}
