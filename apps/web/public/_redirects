# SPA fallbacks for client-routed pages that `nuxi generate` does not prerender.
# This file is copied into the Amplify publish directory. Specific 200 rewrites
# run first; keep the 404 catch-all last.
# CI `nuxi start` uses `serve`, which ignores this file — keep public/serve.json
# in sync for the same fallbacks (see #1785). The per-locale directory splats
# below are the exception: `serve` applies a matching rewrite instead of the
# clean URL, so `/zh-CN/about` would become the SPA shell. Amplify serves an
# existing file first, so marketing HTML still wins here.
# Add new dynamic prefixes here rather than a blanket 200 rewrite.
#
# Umami. The page loads /stats.js and posts to /api/send on this origin.
# These 200s proxy to Umami so ad blockers never see cloud.umami.is or
# gateway.umami.is. `nuxi generate` rewrites the destinations from
# NUXT_PUBLIC_UMAMI_URL when that host is not Umami Cloud. Keep them
# above the 404 catch-all.
/stats.js       https://cloud.umami.is/script.js       200
/api/send       https://gateway.umami.is/api/send      200

/search             /200.html   200
/u/*                /200.html   200
/login              /200.html   200
/login/*            /200.html   200
/my-page            /200.html   200
/my-page/*          /200.html   200
/book               /200.html   200
/book/*             /200.html   200
/dashboard          /200.html   200
/clinic-dashboard   /200.html   200
/clinic-dashboard/* /200.html   200
/:locale/search     /200.html   200
/:locale/u/*        /200.html   200
/:locale/login      /200.html   200
/:locale/login/*    /200.html   200
/:locale/my-page    /200.html   200
/:locale/my-page/*  /200.html   200
/:locale/book       /200.html   200
/:locale/book/*     /200.html   200
/:locale/dashboard  /200.html   200
/:locale/clinic-dashboard   /200.html   200
/:locale/clinic-dashboard/* /200.html   200

# Directory HTML is generated for en-US and ja-JP only. These locales still
# have static marketing pages; this rewrite covers the directory URLs generate
# skipped. Do not add /ja-JP/* — unknown Japanese clinics must stay a hard 404.
/zh-CN/*            /200.html   200
/vi-VN/*            /200.html   200
/ko-KR/*            /200.html   200
/tl-PH/*            /200.html   200
/ne-NP/*            /200.html   200
/id-ID/*            /200.html   200
/pt-BR/*            /200.html   200
/fr-FR/*            /200.html   200
/ru-RU/*            /200.html   200
/de-DE/*            /200.html   200
/it-IT/*            /200.html   200

# Unknown paths stay a real 404 (not a soft 200 SPA shell).
/*              /404.html   404
