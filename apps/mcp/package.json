{
    "name": "@findadoc/mcp",
    "version": "0.1.0",
    "description": "Find a Doc MCP Server",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsx watch src/index.ts",
        "dev:http": "tsx watch src/http.ts",
        "start": "node dist/index.js",
        "start:http": "node dist/http.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --coverage",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "mcp",
        "findadoc",
        "healthcare",
        "japan"
    ],
    "license": "BSD-3-Clause",
    "engines": {
        "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
    },
    "dependencies": {
        "@fastify/aws-lambda": "5.1.4",
        "@fastify/rate-limit": "^10.3.0",
        "@findadoc/graphql": "workspace:*",
        "@findadoc/utils": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "fastify": "^5.8.5",
        "graphql": "catalog:",
        "graphql-request": "^7.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@findadoc/tsconfig": "workspace:*",
        "@stylistic/eslint-plugin": "^2.0.0",
        "@types/aws-lambda": "^8.10.164",
        "@types/node": "^25.5.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "tsx": "^4.0.0",
        "typescript": "catalog:",
        "vitest": "^3.2.6"
    }
}
