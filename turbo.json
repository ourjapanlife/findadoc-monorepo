{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"]
        },
        "generate": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "lint:fix": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "lint:locales": {
            "cache": false
        },
        "test": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:e2e:headless": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "dev": {
            "persistent": true,
            "cache": false,
            "dependsOn": ["^build"]
        },
        "dev:http": {
            "persistent": true,
            "cache": false,
            "dependsOn": ["^build"]
        }
    }
}
