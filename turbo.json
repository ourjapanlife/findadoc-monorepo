{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "generate": {
            "cache": false,
            "inputs": ["codegen.ts", "$TURBO_ROOT$/apps/server/src/typeDefs/schema.graphql"],
            "outputs": ["src/index.ts"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".output/**", ".nuxt/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "lint:fix": {
            "cache": false,
            "dependsOn": ["^build"]
        },
        "lint:locales": {
            "cache": false
        },
        "test": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:e2e:headless": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "dev:http": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        }
    }
}
